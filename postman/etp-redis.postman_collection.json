              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 429', () => pm.expect(pm.response.code).to.be.oneOf([429]));",
                  "  const json = pm.response.json() || {};",
                  "  const data = json.data || {};",
                  "  pm.test('error.code = RATE_LIMITED', () => pm.expect((json.error || {}).code).to.eql('RATE_LIMITED'));",
                  "  pm.test('Có Retry-After (giây)', () => pm.expect(Number(pm.response.headers.get('Retry-After'))).to.be.within(1, 60));",
                  "  pm.collectionVariables.set('wrongLoginCount', 0);",
                  "})();"
                ]
              }
            }
          ],
