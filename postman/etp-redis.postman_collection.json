  "item": [
    {
      "name": "1. Kiểm tra hệ thống",
      "item": [
        {
          "name": "Health: database + Redis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "  const json = pm.response.json() || {};",
                  "  const data = json.data || {};",
                  "  pm.test('Redis up', () => pm.expect(data.checks.redis).to.eql('up'));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{host}}/health/ready",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
