{
  "info": {
    "name": "ETP — Redis (Phase 6)",
    "description": "Điền email/password ở tab Variables rồi Run từ trên xuống. Folder 5 cố tình làm IP của bạn bị chặn đăng nhập khoảng 1 phút (5 lần/phút): chạy nó cuối cùng.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(function () {",
          "  const path = pm.request.url.getPath();",
          "  if (path.endsWith('/auth/login') || path.endsWith('/auth/refresh')) {",
          "    return; // these requests manage tokens themselves",
          "  }",
          "  const SAFETY_SECONDS = 30;",
          "  const expiresAt = (token) => {",
          "    try {",
          "      const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
          "      return JSON.parse(require('atob')(payload)).exp || 0;",
          "    } catch (e) {",
          "      return 0;",
          "    }",
          "  };",
          "  const isFresh = (name) => {",
          "    const token = pm.variables.get(name);",
          "    return Boolean(token) && expiresAt(token) > Date.now() / 1000 + SAFETY_SECONDS;",
          "  };",
          "  const post = (url, body, onSuccess) => pm.sendRequest({",
          "    url: pm.variables.get('host') + url,",
          "    method: 'POST',",
          "    header: [{ key: 'Content-Type', value: 'application/json' }],",
          "    body: { mode: 'raw', raw: JSON.stringify(body) },",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) onSuccess(res.json().data);",
          "  });",
          "  const auth = JSON.stringify(pm.request.auth ? pm.request.auth.toJSON() : {});",
          "  ",
          "  if (auth.includes('adminToken') && !isFresh('adminToken') && pm.variables.get('adminPassword')) {",
          "    post('/api/v1/auth/login', {",
          "      email: pm.variables.get('adminEmail'),",
          "      password: pm.variables.get('adminPassword'),",
          "    }, (data) => {",
          "      pm.collectionVariables.set('adminToken', data.accessToken);",
          "      console.log('Token admin đã hết hạn → tự đăng nhập lại');",
          "    });",
          "  }",
          "  if (auth.includes('userToken') && !isFresh('userToken') && pm.variables.get('userRefreshToken')) {",
          "    post('/api/v1/auth/refresh', { refreshToken: pm.variables.get('userRefreshToken') }, (data) => {",
          "      pm.collectionVariables.set('userToken', data.accessToken);",
          "      pm.collectionVariables.set('userRefreshToken', data.refreshToken);",
          "      console.log('Token của bạn đã hết hạn → tự refresh');",
          "    });",
          "  }",
          "})();"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:3001"
    },
    {
      "key": "adminEmail",
      "value": "admin@etp.local"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123456"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "userRefreshToken",
      "value": ""
    },
    {
      "key": "phoneToken",
      "value": ""
    },
    {
      "key": "phoneRefreshToken",
      "value": ""
    },
    {
      "key": "wrongLoginCount",
      "value": ""
    }
