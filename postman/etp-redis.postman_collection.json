    {
      "name": "5. Giới hạn số request (chạy CUỐI CÙNG)",
      "item": [
        {
          "name": "Đăng nhập sai liên tục (tự lặp tới khi bị 429)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  if (pm.info.iteration === 0 && !pm.variables.get('wrongLoginCount')) pm.collectionVariables.set('wrongLoginCount', 0);",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 401/429', () => pm.expect(pm.response.code).to.be.oneOf([401,429]));",
                  "  const json = pm.response.json() || {};",
                  "  const data = json.data || {};",
                  "  const count = Number(pm.variables.get('wrongLoginCount') || 0) + 1;",
                  "  pm.collectionVariables.set('wrongLoginCount', count);",
                  "  console.log('Lần ' + count + ': ' + pm.response.code + ', còn lại ' + pm.response.headers.get('RateLimit-Remaining'));",
                  "  // Trong Collection Runner: gửi lại chính request này cho tới khi bị chặn (tối đa 6 lần).",
                  "  if (pm.response.code === 401 && count < 6 && typeof postman !== 'undefined') postman.setNextRequest(pm.info.requestName);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
