          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  // 30 ngày nữa, 19:00 → 21:00 giờ Việt Nam (12:00 → 14:00 UTC).",
                  "  const start = new Date();",
                  "  start.setUTCDate(start.getUTCDate() + 30);",
                  "  start.setUTCHours(12, 0, 0, 0);",
                  "  const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);",
                  "  pm.collectionVariables.set('startAt', start.toISOString());",
                  "  pm.collectionVariables.set('endAt', end.toISOString());",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "  const data = (pm.response.json() || {}).data || {};",
                  "  if (data.schedule && data.schedule.id !== undefined) pm.collectionVariables.set('scheduleId', data.schedule && data.schedule.id);",
                  "})();"
                ]
              }
            }
          ],
