                "exec": [
                  "(function () {",
                  "  pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "  const data = (pm.response.json() || {}).data || {};",
                  "  if (data.accessToken !== undefined) pm.collectionVariables.set('adminToken', data.accessToken);",
                  "})();"
