              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{host}}/api/v1/events/{{eventId}}/schedules"
          }
        },
        {
          "name": "Thử thêm suất TRÙNG GIỜ cùng địa điểm (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  if (!pm.variables.get('startAt') || !pm.variables.get('endAt')) {",
                  "    throw new Error('Chưa có giờ diễn. Chạy request \"Thêm suất diễn\" trước (request đó tự tính startAt/endAt).');",
                  "  }",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 409', () => pm.expect(pm.response.code).to.be.oneOf([409]));",
                  "  pm.test('Error code SCHEDULE_CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('SCHEDULE_CONFLICT'));",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"venueId\": \"{{venueId}}\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
