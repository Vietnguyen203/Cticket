      "item": [
        {
          "name": "Đăng nhập admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "  const data = (pm.response.json() || {}).data || {};",
                  "  // Phase 15: no token yet for an admin, only the mfaToken of the two-factor step.",
                  "  pm.test('Admin cần mã xác thực hai lớp', () => pm.expect(data.mfaRequired).to.eql(true));",
                  "  if (data.mfaToken) pm.collectionVariables.set('adminMfaToken', data.mfaToken);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{host}}/api/v1/auth/login"
          }
        },
        {
          "name": "Admin nhập mã 2FA (tự tính từ adminTotpSecret)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Phase 15: admins sign in with two-factor. The code is computed here from the",
                  "// collection variable adminTotpSecret: the admin's setup key (base32), the one the",
                  "// web shows under \"Không quét được? Nhập khóa bằng tay\" when two-factor is set up.",
                  "(function () {",
                  "  const CryptoJS = require('crypto-js');",
                  "  const secret = (pm.collectionVariables.get('adminTotpSecret') || '').toUpperCase().replace(/[\\s=]/g, '');",
                  "  if (!secret) throw new Error('Set the collection variable adminTotpSecret (the admin two-factor setup key).');",
                  "  const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "  let bits = '';",
                  "  for (const char of secret) bits += alphabet.indexOf(char).toString(2).padStart(5, '0');",
                  "  let keyHex = '';",
                  "  for (let i = 0; i + 8 <= bits.length; i += 8) keyHex += parseInt(bits.slice(i, i + 8), 2).toString(16).padStart(2, '0');",
                  "  const counterHex = Math.floor(Date.now() / 1000 / 30).toString(16).padStart(16, '0');",
                  "  const hmac = CryptoJS.HmacSHA1(CryptoJS.enc.Hex.parse(counterHex), CryptoJS.enc.Hex.parse(keyHex)).toString();",
                  "  const offset = parseInt(hmac.slice(-1), 16);",
                  "  const code = (parseInt(hmac.substr(offset * 2, 8), 16) & 0x7fffffff) % 1000000;",
                  "  pm.collectionVariables.set('adminTotpCode', String(code).padStart(6, '0'));",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.test('Status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "  const data = (pm.response.json() || {}).data || {};",
                  "  if (data.accessToken) pm.collectionVariables.set('adminAccessToken', data.accessToken);",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{host}}/api/v1/auth/login/2fa",
            "body": {
