# Production settings (Phase 16). The real file is deploy/.env, ON THE SERVER
# ONLY (chmod 600), never in git. Create it with:
#   bash deploy/scripts/init-env.sh ve.example.com you@example.com
# which copies this file and fills every secret with random values made on
# the server. Then set the SMTP_* lines below.

# --- Site --------------------------------------------------------------------
# The web address (an A record of this name points to the server's IP).
DOMAIN=ve.example.com
# An email for Let's Encrypt (certificate expiry notices), or "internal" for a
# local certificate when rehearsing on a computer with DOMAIN=etp.localhost.
CADDY_TLS=you@example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Database / Redis (only reachable inside Docker) ---------------------------
POSTGRES_USER=etp
POSTGRES_DB=etp
POSTGRES_PASSWORD=__RANDOM__
REDIS_PASSWORD=__RANDOM__
# PG_POOL_MAX=15
# API processes per API container, sharing PG_POOL_MAX (a number or auto)
# API_WORKERS=2

# --- Secrets of the API (random; changing one has consequences, see
# docs/production-checklist.md) -----------------------------------------------
JWT_ACCESS_SECRET=__RANDOM__
OTP_SECRET=__RANDOM__
# Changing it voids every QR code already issued.
QR_SECRET=__RANDOM__
# Encrypts two-factor secrets. Losing it = everyone sets two-factor up again.
TOTP_ENCRYPTION_KEY=__RANDOM_32_BYTES_BASE64__
# TWO_FACTOR_REQUIRED_ROLES=ADMIN

# --- Email (a real SMTP service; see docs/deployment.md, section 6) -------------
# Brevo: smtp-relay.brevo.com, port 587. Resend: smtp.resend.com, port 587.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, an App Password, and
# MAIL_FROM with the same Gmail address.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ETP Tickets <no-reply@ve.example.com>

# --- Payments: VNPay (Phase 17; docs/deployment.md, section 13) ---------------------
# From VNPay's registration email (sandbox: http://sandbox.vnpayment.vn/devreg/).
# Empty = VNPay off. In VNPay's merchant portal, set the IPN URL to
#   https://<DOMAIN>/api/v1/payments/vnpay/ipn
# The return URL is set by the server: https://<DOMAIN>/payments/vnpay/return
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox by default; for real money, VNPay gives the production addresses:
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# This server's public IP (sent with querydr / refund requests).
# VNPAY_SERVER_IP=203.0.113.10
# The free simulated payment: keep it off on a real site (true only for a demo).
# PAYMENT_SIMULATOR=false

# --- Backups (scripts/backup.sh) ---------------------------------------------------
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Off-site copy (optional): an rclone remote and path, e.g. r2:etp-backups
# (scripts/offsite-sync.sh; rclone config in deploy/rclone/rclone.conf).
# OFFSITE_REMOTE=

# LOG_LEVEL=info
