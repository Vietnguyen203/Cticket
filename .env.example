# Copy to .env (next to docker-compose.yml). Used by `docker compose`.
POSTGRES_USER=etp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etp
POSTGRES_PORT=5432
API_PORT=3000

# Must be the same values as in backend/.env. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
OTP_SECRET=replace-with-another-random-string-of-32-chars

# Real email for the Docker API (leave unset to use the Mailpit inbox).
# Gmail: SMTP_PASS is a 16-character App Password; MAIL_FROM uses the same address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=
# MAIL_FROM=Event Tickets <your.address@gmail.com>

# Redis (cache, rate limits, OTP, seat locks). Generate like the secrets above.
REDIS_PASSWORD=replace-with-a-random-string
REDIS_PORT=6379

# Web app origins (Vite dev server, Docker web): allowed to open the WebSocket.
# Add https://<LAN IP>:5173 to test the staff scanner from a phone.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost:8443

# Signs ticket QR codes. Generate like the secrets above; same value in backend/.env.
QR_SECRET=replace-with-a-third-random-string-of-32-chars
