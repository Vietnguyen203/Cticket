# Copy to .env (next to docker-compose.yml). Used by `docker compose`.
POSTGRES_USER=etp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etp
POSTGRES_PORT=5432
# The API on this computer. The web dev server (Vite) forwards to 3001 by default;
# 3000 stays free for an API run outside Docker (backend: npm run dev).
API_PORT=3001
# The web app (nginx): http on this computer, https for phones (camera).
WEB_PORT=8080
WEB_HTTPS_PORT=8443
# Mailpit: SMTP for the containers, inbox at http://localhost:8025
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Must be the same values as in backend/.env. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
OTP_SECRET=replace-with-another-random-string-of-32-chars

# Real email for the Docker API (leave unset to use the Mailpit inbox).
# Gmail: SMTP_PASS is a 16-character App Password; MAIL_FROM uses the same address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=
# MAIL_FROM=Event Tickets <your.address@gmail.com>

# Redis (cache, rate limits, OTP, seat locks). Generate like the secrets above.
REDIS_PASSWORD=replace-with-a-random-string
REDIS_PORT=6379

# Web app origins (Vite dev server, Docker web): allowed to open the WebSocket.
# Add https://<LAN IP>:5173 to test the staff scanner from a phone.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://localhost:8443

# Proxies in front of the API: 1 = the web container (nginx). Add one per extra
# load balancer in front of it (docs/production-checklist.md).
# TRUST_PROXY=1

# Signs ticket QR codes. Generate like the secrets above; same value in backend/.env.
QR_SECRET=replace-with-a-third-random-string-of-32-chars

# Two-factor authentication (Phase 15). Encrypts the TOTP secrets: exactly 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means every user must set two-factor up again: back it up with the other secrets.
TOTP_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
# Roles that must use two-factor (comma-separated). Keep ADMIN in production.
# TWO_FACTOR_REQUIRED_ROLES=ADMIN

# VNPay sandbox (Phase 17). Register at http://sandbox.vnpayment.vn/devreg/ and
# copy the two values from VNPay's email. Empty = VNPay off (the simulator only).
# For VNPay's IPN to reach this computer, start the tunnel (docs/phase-17-vnpay-design.md):
#   docker compose --profile tunnel up -d tunnel
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# Where VNPay sends the customer back (the Docker web app by default).
# VNPAY_RETURN_URL=http://localhost:8080/payments/vnpay/return
# The free simulated payment (on by default for this local stack).
# PAYMENT_SIMULATOR=true
