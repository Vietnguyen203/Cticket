# Copy to backend/.env for running the API on your machine (npm run dev).
# Inside Docker, these values come from docker-compose.yml instead.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgres://etp:change-me@localhost:5432/etp
# Used by `npm test`. The test runner DROPS AND RECREATES this database's schema,
# and refuses to run unless the database name ends with "_test".
TEST_DATABASE_URL=postgres://etp:change-me@localhost:5432/etp_test

PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000

# Comma-separated browser origins allowed by CORS and by the WebSocket Origin
# check (empty = none). The web app (Phase 11) runs on http://localhost:5173.
CORS_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# --- Auth ---------------------------------------------------------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Web app refresh cookie: Secure flag (default: true only when NODE_ENV=production)
# REFRESH_COOKIE_SECURE=false
OTP_SECRET=replace-with-another-random-string-of-32-chars
BCRYPT_COST=12

# --- Email ----------------------------------------------------------------
# Option A (default): Mailpit, a fake inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Event Tickets <no-reply@etp.local>

# Option B: real delivery through Gmail. Comment out option A, then:
#   SMTP_PASS is a 16-character App Password (Google Account → Security →
#   2-Step Verification → App passwords), NOT your Gmail password.
#   MAIL_FROM must use the same address as SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=
# MAIL_FROM=Event Tickets <your.address@gmail.com>
#
# Check the settings with:  npm run mail:test -- you@example.com

# Signs ticket QR codes (a QR cannot be forged without it). >= 32 characters.
QR_SECRET=replace-with-a-third-random-string-of-32-chars

# --- Redis -----------------------------------------------------------------
# Same password as REDIS_PASSWORD in the root .env (docker compose).
REDIS_URL=redis://:replace-with-the-redis-password@localhost:6379/0
# Tests use database 15 and wipe it before every run.
TEST_REDIS_URL=redis://:replace-with-the-redis-password@localhost:6379/15
# Behind a reverse proxy (nginx, load balancer): number of proxy hops to trust,
# so rate limits see the client IP instead of the proxy's.
# TRUST_PROXY=1

# --- Background jobs (optional) ----------------------------------------------
# bullmq: jobs go to Redis and src/worker.js runs them (npm run worker).
# inline: run them inside the API process (the test suite does this).
# QUEUE_MODE=bullmq
# WORKER_CONCURRENCY=5
# QUEUE_RETRY_DELAY_MS=5000

# --- WebSocket (optional) -------------------------------------------------
# Ping interval; a client that misses one ping is disconnected.
# WS_HEARTBEAT_SECONDS=30

# --- Booking (optional) ----------------------------------------------------
# Minutes a HELD order keeps its seats, and how often expired holds are swept.
# HOLD_TTL_MINUTES=10
# Checkout extends the hold once by this many minutes, to pay.
# PAYMENT_WINDOW_MINUTES=10
# ORDER_SWEEP_INTERVAL_SECONDS=30

# --- npm run seed:admin (optional; defaults to the dev admin) ------------
# ADMIN_EMAIL=admin@etp.local
# ADMIN_PASSWORD=admin
